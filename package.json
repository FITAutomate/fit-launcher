{
  "name": "fit-launcher",
  "productName": "FIT Launcher",
  "version": "0.1.0-preview.5",
  "description": "A portable Windows home for quick repository tasks",
  "main": "dist/main.cjs",
  "author": "FITAutomate",
  "license": "MIT",
  "repository": "https://github.com/FITAutomate/fit-launcher",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "npm run build && playwright test",
    "make": "npm run build && electron-forge make --platform=win32 --arch=x64 && node scripts/assemble-portable.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "format": "prettier --write src tests scripts *.json *.cjs *.ts .github docs README.md CONTRIBUTING.md",
    "format:check": "prettier --check src tests scripts *.json *.cjs *.ts .github docs README.md CONTRIBUTING.md"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "adm-zip": "0.6.1",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
